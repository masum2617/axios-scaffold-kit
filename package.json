{
  "name": "axios-scaffold-kit",
  "version": "0.1.0",
  "description": "Generate an editable JavaScript Axios API starter with optional authentication hooks and consent-controlled Axios installation.",
  "type": "module",
  "bin": {
    "axios-scaffold-kit": "bin/axios-scaffold-kit.js"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "test": "node --test",
    "test:auth": "node scripts/run-auth-tests.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masum2617/axios-scaffold-kit.git"
  },
  "homepage": "https://github.com/masum2617/axios-scaffold-kit#readme",
  "bugs": {
    "url": "https://github.com/masum2617/axios-scaffold-kit/issues"
  },
  "keywords": [
    "axios",
    "scaffold",
    "cli",
    "api",
    "javascript"
  ],
  "files": [
    "bin/",
    "src/",
    "templates/",
    "CHANGELOG.md",
    "docs/AUTHENTICATION.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
